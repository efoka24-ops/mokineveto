# MokineVeto API — routage et protections.
#
# Ce répertoire EST la racine du sous-domaine : les chemins publics sont donc
# /health, /auth/login, etc., sans préfixe /api.
#
# Volontairement limité à mod_rewrite et mod_alias : l'hébergement refuse
# `Options` et les directives d'autorisation Apache 2.4 (`Require`), qui
# provoquent une erreur 500.

RewriteEngine On

# L'en-tête Authorization n'est pas transmis à PHP par certaines configurations
# Apache : sans cette ligne, toutes les requêtes authentifiées échoueraient.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ─── Protections ───────────────────────────────────────────────────────────
# Le compte FTP étant enraciné sur public_html, le fichier d'environnement ne
# peut pas être placé au-dessus de la racine web. Ces règles sont donc la seule
# barrière devant les identifiants. Elles passent AVANT la réécriture, sans quoi
# un fichier existant serait servi tel quel.

RedirectMatch 404 (?i)(^|/)\.env($|/)
RedirectMatch 404 (?i)^/(lib|routes)/
RedirectMatch 404 (?i)\.(sql|log|bak|ini)$

# ─── Routage ───────────────────────────────────────────────────────────────
# Toute requête qui ne correspond pas à un fichier existant est confiée à
# index.php, le chemin demandé étant passé dans __path.

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?__path=$1 [QSA,L]
